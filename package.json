{
  "name": "busfactor",
  "version": "0.1.0",
  "description": "Ranks your direct npm dependencies by how badly you'd be stuck if the maintainers vanished.",
  "type": "module",
  "bin": {
    "busfactor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/fredykohv/busfactor#readme",
  "bugs": {
    "url": "https://github.com/fredykohv/busfactor/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "keywords": [
    "dependencies",
    "truck-factor",
    "bus-factor",
    "supply-chain",
    "maintenance",
    "risk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredykohv/busfactor.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
